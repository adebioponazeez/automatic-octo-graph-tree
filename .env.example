# ==========================================
# Octo Harness - Environment Configuration
# ==========================================

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_API_KEY=your-custom-secret-key-here
OCTO_MOCK_MODE=false
DEBUG=false

# Maximum Total Budget Guardrail (USD)
BUDGET_LIMIT_USD=100.00

# Primary Routing Strategy: grok_primary | quality_first | cost_optimized | latency_optimized
DEFAULT_STRATEGY=grok_primary

# ==========================================
# xAI Grok Configuration
# ==========================================
GROK_API_KEY=xai-your-api-key-here
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT=30.0
GROK_RPS=30.0

# ==========================================
# OpenAI ChatGPT Configuration
# ==========================================
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30.0
OPENAI_RPS=30.0

# ==========================================
# Anthropic Claude Configuration
# ==========================================
ANTHROPIC_API_KEY=ant-your-anthropic-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TIMEOUT=30.0
ANTHROPIC_RPS=20.0

# ==========================================
# Local Inference (Ollama / vLLM / llama.cpp)
# ==========================================
LOCAL_API_KEY=local
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_TIMEOUT=60.0
LOCAL_RPS=50.0

# ==========================================
# Circuit Breaker & Safety
# ==========================================
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0
